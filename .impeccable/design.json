      "html": "<button class=\"ds-button-primary\" type=\"button\">验证并生成</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:8px 16px;border-radius:6px;font-family:var(--font-reading);font-size:14px;font-weight:500;line-height:20px;cursor:pointer;transition:color 150ms cubic-bezier(.4,0,.2,1),background-color 150ms cubic-bezier(.4,0,.2,1);background:var(--primary);color:var(--primary-foreground);border:0;}.ds-button-primary:hover{background:color-mix(in oklab,var(--primary) 90%,transparent);}.ds-button-primary:focus-visible{outline:2px solid var(--primary);outline-offset:4px;}.ds-button-primary:disabled{pointer-events:none;opacity:.5;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}}"
    },
