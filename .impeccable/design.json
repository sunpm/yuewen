    },
    {
      "name": "连接主卡片",
      "kind": "card",
      "refersTo": "connection-panel",
      "description": "用户选定的设置页容器，不替代普通数据卡片。",
      "html": "<section class=\"ds-connection-panel\"><div class=\"ds-connection-heading\"><h2>临时连接</h2><span>尚未连接</span></div><p>粘贴 API Key 即可查看和下载。</p></section>",
      "css": ".ds-connection-panel{padding:32px;border:1px solid var(--border);border-radius:12px;background:var(--surface);color:var(--foreground);font-family:var(--font-reading);}.ds-connection-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:10px;}.ds-connection-heading h2{margin:0;font-size:23px;font-weight:500;line-height:1.5;}.ds-connection-heading span{display:inline-flex;align-items:center;gap:8px;white-space:nowrap;color:var(--muted-foreground);font-size:14px;}.ds-connection-heading span::before{content:\"\";width:6px;height:6px;border-radius:50%;background:currentColor;}.ds-connection-panel p{margin:0;color:var(--muted-foreground);font-size:14px;line-height:1.75;}"
    },
    {
      "name": "笔记正文",
      "kind": "custom",
