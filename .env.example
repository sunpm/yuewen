# 仅供本地真实数据联调；不要注入前端构建或公开服务的生产环境。
WEREAD_API_KEY=
# E2E 使用 mock；留空时本地示例默认读取上面的 Key。
WEREAD_DEMO_MODE=

# 本地与生产各自配置；这些变量只能用于服务端。
APP_URL=http://127.0.0.1:5173
DATABASE_URL=
BETTER_AUTH_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
# JSON 对象：版本号对应一个 32 字节随机密钥的 Base64 编码。
KEY_ENCRYPTION_VERSION=1
KEY_ENCRYPTION_KEYS={}

# 后台单独启用；先迁移，再运行显式初始化命令。密钥不得与前台共用。
CONSOLE_AUTH_SECRET=
CONSOLE_ADMIN_USERNAME=
CONSOLE_ADMIN_PASSWORD=
# 应用 0000–0004 迁移后可单独启用 C3 只读查询，不依赖反馈/R2 开关。
CONSOLE_DATA_ENABLED=false

# 先应用 C2 迁移；完成对应环境的 R2/生命周期验收后再开启反馈。
FEEDBACK_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# PC 基础统计：仅 Netlify Production 构建读取，默认关闭；不使用 Cloudflare 自动注入。
# APP_URL 必须为正式 HTTPS origin；token 是 Web Analytics 公开站点 token，不是 API 凭据。
PC_ANALYTICS_ENABLED=false
CF_WEB_ANALYTICS_TOKEN=

# 独立恢复日志默认关闭；启用时必须配置专用私有存储及保留规则，详见恢复手册。
RECOVERY_LOG_ENABLED=false
RECOVERY_R2_ACCOUNT_ID=
RECOVERY_R2_ACCESS_KEY_ID=
RECOVERY_R2_SECRET_ACCESS_KEY=
RECOVERY_R2_BUCKET=
RECOVERY_SCOPE=
# 每次首次启用或中断后重新启用生成新的 UUID，旧 epoch 备份不再用于开放恢复。
RECOVERY_EPOCH=
# 以下仅供隔离运维/备份进程，不提供给应用 Functions；数据库名必须显式匹配。
RECOVERY_DATABASE=
RECOVERY_CODE_REVISION=
RECOVERY_ENCRYPTION_KEY=
RECOVERY_WRITES_FROZEN=false
# PostgreSQL 官方客户端所在目录；留空从 PATH 查找。
PG_BIN=
