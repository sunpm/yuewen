# 仅供本地真实数据联调；不要注入前端构建或公开服务的生产环境。
WEREAD_API_KEY=
# E2E 使用 mock；留空时本地示例默认读取上面的 Key。
WEREAD_DEMO_MODE=

# 本地与生产各自配置；这些变量只能用于服务端。
APP_URL=http://127.0.0.1:5173
DATABASE_URL=
BETTER_AUTH_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
# JSON 对象：版本号对应一个 32 字节随机密钥的 Base64 编码。
KEY_ENCRYPTION_VERSION=1
KEY_ENCRYPTION_KEYS={}

# 后台单独启用；先迁移，再运行显式初始化命令。密钥不得与前台共用。
CONSOLE_AUTH_SECRET=
CONSOLE_ADMIN_USERNAME=
CONSOLE_ADMIN_PASSWORD=
# 应用 0000–0004 迁移后可单独启用 C3 只读查询，不依赖反馈/R2 开关。
CONSOLE_DATA_ENABLED=false

# 先应用 C2 迁移；完成对应环境的 R2/生命周期验收后再开启反馈。
FEEDBACK_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
