{
  "name": "yuewen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch --env-file=.env server/dev.ts",
    "build": "pnpm build:web && pnpm build:mobile && pnpm build:console",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "pnpm typecheck:vue && pnpm typecheck:react && pnpm typecheck:console",
    "lint": "eslint . && biome check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "probe": "tsx --env-file=.env scripts/probe.ts",
    "probe:report": "tsx --env-file=.env scripts/probe-report.ts",
    "format": "prettier --write . && biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env server/db/migrate.ts",
    "db:backup": "tsx --env-file=.env scripts/database-recovery.ts backup",
    "db:restore": "tsx --env-file=.env scripts/database-recovery.ts restore",
    "feedback:cleanup": "tsx --env-file=.env scripts/cleanup-feedback.ts --run",
    "dev:mobile": "vite --config vite.mobile.config.ts --host 127.0.0.1",
    "build:web": "vite build",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "typecheck:vue": "vue-tsc --noEmit",
    "typecheck:react": "tsc --noEmit -p tsconfig.react.json",
    "dev:console": "vite --config vite.console.config.ts",
    "build:console": "vite build --config vite.console.config.ts",
    "typecheck:console": "tsc --noEmit -p tsconfig.console.json",
    "console:admin:init": "tsx --env-file=.env scripts/console-admin.ts init",
    "console:admin:reset": "tsx --env-file=.env scripts/console-admin.ts reset",
    "test:console": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.console.config.ts"
  },
  "dependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@aws-sdk/client-s3": "3.1149.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@hono/node-server": "2.1.3",
    "@hookform/resolvers": "5.9.1",
    "@napi-rs/canvas": "1.0.10",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-slot": "1.4.0",
    "@tanstack/react-query": "5.104.1",
    "antd": "6.6.5",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-cloud": "^1.2.9",
    "drizzle-orm": "0.45.3",
    "echarts": "6.1.0",
    "hono": "4.13.12",
    "html-to-image": "1.11.13",
    "lucide-react": "1.53.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-router": "8.4.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "vant": "4.10.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/d3-cloud": "^1.2.9",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vant/auto-import-resolver": "1.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "2.5.1",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.0",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vue-tsc": "3.3.12"
  }
}
