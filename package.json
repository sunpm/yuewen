{
  "name": "yuewen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch --env-file=.env server/dev.ts",
    "build": "pnpm build:web && pnpm build:mobile",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "probe": "tsx --env-file=.env scripts/probe.ts",
    "probe:report": "tsx --env-file=.env scripts/probe-report.ts",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env server/db/migrate.ts",
    "dev:mobile": "vite --config vite.mobile.config.ts --host 127.0.0.1",
    "build:web": "vite build",
    "build:mobile": "vite build --config vite.mobile.config.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@hono/node-server": "2.1.3",
    "@lucide/vue": "1.51.0",
    "@napi-rs/canvas": "1.0.10",
    "@vueuse/core": "15.0.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-cloud": "^1.2.9",
    "drizzle-orm": "0.45.3",
    "echarts": "6.1.0",
    "hono": "4.13.12",
    "postgres": "3.4.9",
    "reka-ui": "2.10.5",
    "tailwind-merge": "3.7.0",
    "vant": "4.10.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-cloud": "^1.2.9",
    "@types/node": "^22.20.5",
    "@vant/auto-import-resolver": "1.3.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "2.5.1",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.0",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vue-tsc": "3.3.12"
  }
}
