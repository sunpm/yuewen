{
  "name": "yuewen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --config wrangler.local.jsonc --local --ip 127.0.0.1",
    "build": "pnpm build:web && pnpm build:mobile",
    "brand:generate": "tsx scripts/generate-brand.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "pnpm typecheck:vue && pnpm typecheck:react",
    "lint": "eslint . && biome check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "probe": "tsx --env-file=.env scripts/probe.ts",
    "probe:report": "tsx --env-file=.env scripts/probe-report.ts",
    "format": "prettier --write . && biome check --write .",
    "dev:mobile": "vite --config vite.mobile.config.ts --host 127.0.0.1",
    "build:web": "vite build",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "typecheck:vue": "vue-tsc --noEmit",
    "typecheck:react": "tsc --noEmit -p tsconfig.react.json",
    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy": "pnpm build && pnpm deploy:prepare && wrangler deploy",
    "deploy:prepare": "wrangler d1 migrations apply DB --remote",
    "check:worker": "wrangler deploy --dry-run",
    "dev:preview": "pnpm build && pnpm dev:api",
    "test:d1": "node --import tsx scripts/smoke-d1.ts",
    "deploy:init": "pnpm build && wrangler deploy && pnpm deploy:prepare",
    "test:http": "node scripts/smoke-http.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.10",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-slot": "1.4.0",
    "@tanstack/react-query": "5.104.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-cloud": "^1.2.9",
    "echarts": "6.1.0",
    "hono": "4.13.12",
    "html-to-image": "1.11.13",
    "lucide-react": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "vant": "4.10.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "4.6.5",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/d3-cloud": "^1.2.9",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vant/auto-import-resolver": "1.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "2.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.0",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vue-tsc": "3.3.12",
    "wrangler": "^4.86.0",
    "@cloudflare/workers-types": "5.20261120.1"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "新实例专用阅读报告数据库；不要选择旧系统或其他实例的数据库。"
      },
      "WEREAD_API_KEY": {
        "description": "微信读书上游读取授权，可部署后通过 Worker Secret 添加；不是阅纹账号。"
      },
      "ACCESS_TEAM_DOMAIN": {
        "description": "Cloudflare Access 团队地址，例如 https://your-team.cloudflareaccess.com。留空时私有 API 拒绝访问。"
      },
      "ACCESS_AUD": {
        "description": "覆盖此实例的 Access Application AUD Tag。请设置仅允许自己的策略。"
      }
    }
  }
}
