{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "web/src/**",
      "!web/src/**/*.vue",
      "!web/src/**/*.d.ts",
      "vite.config.ts",
      "tsconfig.react.json",
      "biome.json",
      "console/**",
      "vite.console.config.ts",
      "tsconfig.console.json",
      "tests/console/**/*.tsx",
      "web/components.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useHookAtTopLevel": "error",
        "useExhaustiveDependencies": "error"
      }
    }
  }
}
