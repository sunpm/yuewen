{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["web/src/*"],
      "@client/*": ["client/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["web/src/**/*.ts", "web/src/**/*.tsx", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
