---
import { createDemo } from '../../../shared/demo'
import { duration } from '../../../shared/report'
import '../styles/home.css'

const report = createDemo('2025', new Date('2025-12-31T12:00:00Z'))
const year = report.range.key
const calendar = report.modules.find((module) => module.kind === 'heatmap')!.data
const firstWeekday = (new Date(report.range.start).getUTCDay() + 6) % 7
const months = report.modules.find((module) => module.id === 2)!.data
const maxHours = Math.max(...months.map((month) => month.value))
const chartMax = Math.ceil(maxHours / 10) * 10
const peakMonth = months.reduce((best, item) => (item.value > best.value ? item : best), months[0])
const shelf = report.books.toSorted((a, b) => (b.seconds ?? 0) - (a.seconds ?? 0)).slice(0, 4)
const maxBookSeconds = Math.max(1, ...shelf.map((book) => book.seconds ?? 0))
const excerpt = report.portrait.quote!
const views = [
  { id: 'time', label: '阅读时间' },
  { id: 'shelf', label: '书架排行' },
  { id: 'notes', label: '划线与想法' },
]
const guides = [
  {
    href: '/docs/deploy/',
    title: '部署到 Cloudflare',
    desc: '创建独立 Worker 与 D1 数据库，配置自己的访问保护',
  },
  {
    href: '/docs/connection/',
    title: '连接微信读书',
    desc: '写入上游读取授权并核验报告采集范围',
  },
  {
    href: '/docs/export/',
    title: '保存与下载报告',
    desc: '留存实例快照，或导出可离线重读的 HTML 与 JSON',
  },
]
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f9f6" />
    <title>阅纹 · 看见你的阅读轨迹</title>
    <meta
      name="description"
      content="把微信读书里的时间、书架与划线，整理成一份可以回看的个人阅读档案。翻看示例，或部署自己的阅纹。"
    />
    <link rel="icon" href="/favicon.svg" media="(prefers-color-scheme: light)" type="image/svg+xml" />
    <link rel="icon" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" type="image/svg+xml" />
    {Astro.site && <link rel="canonical" href={Astro.site.href} />}
    <script is:inline>
      ;(function () {
        var pref = 'auto'
        try {
          pref = localStorage.getItem('yuewen-theme') || 'auto'
        } catch (e) {}
        var dark =
          pref === 'dark' ||
          (pref !== 'light' &&
            typeof matchMedia === 'function' &&
            matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', dark)
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light'
        var meta = document.querySelector('meta[name="theme-color"]')
        if (meta) meta.setAttribute('content', dark ? '#141a17' : '#f8f9f6')
      })()
    </script>
  </head>
  <body>
    <a class="skip" href="#main">跳到主要内容</a>
    <header class="masthead">
      <div class="wrap header-row">
        <a class="brand" href="/" aria-label="阅纹首页">
          <img class="logo-light" src="/favicon.svg" alt="" width="34" height="34" />
          <img class="logo-dark" src="/favicon-dark.svg" alt="" width="34" height="34" />
          <span class="brand-label">阅纹</span>
        </a>
        <div class="header-tools">
          <nav aria-label="主导航">
            <a href="#sample">报告示例</a>
            <a href="/docs/">使用文档</a>
            <a href="https://github.com/sunpm/yuewen" lang="en">GitHub</a>
          </nav>
          <fieldset class="theme-switcher">
            <legend class="sr-only">主题</legend>
            <label class="theme-option" title="自动（跟随系统）">
              <input type="radio" name="site-theme" value="auto" aria-label="自动（跟随系统）" />
              <span class="theme-choice" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="14" x="2" y="3" rx="2" />
                  <line x1="8" x2="16" y1="21" y2="21" />
                  <line x1="12" x2="12" y1="17" y2="21" />
                </svg>
              </span>
            </label>
            <label class="theme-option" title="浅色">
              <input type="radio" name="site-theme" value="light" aria-label="浅色" />
              <span class="theme-choice" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="4" />
                  <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
                </svg>
              </span>
            </label>
            <label class="theme-option" title="深色">
              <input type="radio" name="site-theme" value="dark" aria-label="深色" />
              <span class="theme-choice" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
                </svg>
              </span>
            </label>
          </fieldset>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="wrap hero" aria-labelledby="hero-title">
        <div class="intro">
          <h1 id="hero-title">
            看见你的<br />阅读轨迹<span class="title-accent">。</span>
          </h1>
          <p>
            把微信读书里的时间、书架与划线，<br class="wide-only" />整理成一份可以回看的个人阅读档案。
          </p>
          <div class="actions">
            <a class="button primary" href="#sample">翻开示例报告</a>
            <a class="button" href="/docs/deploy/">自己部署</a>
          </div>
        </div>
        <div
          class="still-life"
          role="img"
          aria-label={year + ' 年模拟阅读年鉴，封面日历记录了 ' + report.summary.readDays + ' 个阅读日'}
        >
          <span class="desk-tag" aria-hidden="true">模拟藏本 · {year}</span>
          <div class="book" aria-hidden="true">
            <div class="cover">
              <div class="imprint"><img src="/favicon.svg" alt="" width="22" height="22" />阅纹</div>
              <div class="cover-title">阅读年鉴</div>
              <div class="year">{year}</div>
              <div class="cover-data">
                <svg viewBox="0 0 265 35" aria-hidden="true">
                  {calendar.map((day, i) => (
                    <rect
                      x={Math.floor((firstWeekday + i) / 7) * 5}
                      y={((firstWeekday + i) % 7) * 5}
                      width="3.5"
                      height="3.5"
                      rx=".6"
                      fill-opacity={day.value ? 0.34 + 0.66 * Math.min(day.value / 100, 1) : 0.12}
                    />
                  ))}
                </svg>
                <div class="colophon">
                  <span>模拟阅读档案</span>
                  <span>{report.summary.readDays} 个阅读日</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="sample-band" id="sample" aria-labelledby="sample-title">
        <div class="wrap spread">
          <div class="section-copy">
            <h2 id="sample-title">翻开示例报告</h2>
            <p>从一年的阅读时间，翻到一本书，再读一条当时留下的划线。</p>
            <dl class="sample-stats">
              <div>
                <dt>全年阅读</dt>
                <dd>{duration(report.summary.seconds)}</dd>
              </div>
              <div>
                <dt>阅读天数</dt>
                <dd>{report.summary.readDays} 天</dd>
              </div>
              <div>
                <dt>最高峰月</dt>
                <dd>{Number(peakMonth.label.slice(5))} 月</dd>
              </div>
            </dl>
            <p class="source">{year} 年模拟记录 · 笔记为原创示例</p>
          </div>
          <fieldset class="sample-report">
            <legend class="sr-only">选择示例内容</legend>
            <div class="report-bar">
              <div class="view-options">
                {views.map((view, i) => (
                  <label>
                    <input type="radio" name="report-view" value={view.id} checked={i === 0} />
                    <span>{view.label}</span>
                  </label>
                ))}
              </div>
              <span class="archive-seal">模拟档案 · {year}</span>
            </div>
            <div class="panel time-panel">
              <h3>每月阅读时长</h3>
              <p class="caption">全年共 {duration(report.summary.seconds)}</p>
              <figure class="chart" aria-label="各月阅读时长，单位为小时">
                {months.map((month) => (
                  <div class={`bar-col${month.label === peakMonth.label ? ' is-peak' : ''}`}>
                    <span class="bar-value">{month.value.toFixed(1)}</span>
                    <span class="bar" style={{ '--fraction': month.value / chartMax }}></span>
                    <span class="month">{Number(month.label.slice(5))}月</span>
                  </div>
                ))}
              </figure>
            </div>
            <div class="panel shelf-panel">
              <h3>读得最久的四本书</h3>
              <p class="caption">按本期阅读时长排列</p>
              <ol class="ranking">
                {shelf.map((book, index) => (
                  <li>
                    <span class="rank-num">{String(index + 1).padStart(2, '0')}</span>
                    <span class="mini-spine" aria-hidden="true">
                      <span>{book.title.slice(0, 1)}</span>
                      {book.cover?.startsWith('https://') && (
                        <img
                          src={book.cover}
                          alt=""
                          loading="lazy"
                          referrerpolicy="no-referrer"
                          onerror="this.remove()"
                        />
                      )}
                    </span>
                    <div class="book-meta">
                      <strong>{book.title}</strong>
                      <small>{book.author}</small>
                    </div>
                    <div class="book-meter">
                      <span class="reading-time">{duration(book.seconds)}</span>
                      <span class="meter-track" aria-hidden="true">
                        <span style={{ width: `${Math.round(((book.seconds ?? 0) / maxBookSeconds) * 100)}%` }}></span>
                      </span>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
            <div class="panel notes-panel">
              <h3>重读一条划线</h3>
              <p class="caption">保留出处与日期，可与统计相互追溯</p>
              <div class="quote-frame">
                <svg class="quote-mark" width="22" height="18" viewBox="0 0 22 18" fill="none" aria-hidden="true">
                  <path d="M8.8 0H2.4L0 8.8V18h8.4V8.8H4.6L8.8 0Zm13.2 0h-6.4L13.2 8.8V18h8.4V8.8h-3.8L22 0Z" fill="currentColor" fill-opacity="0.35" />
                </svg>
                <blockquote>{excerpt.text}</blockquote>
                <p class="caption">
                  《{excerpt.title}》 · {excerpt.author} · {excerpt.date} · 原创示例
                </p>
              </div>
            </div>
          </fieldset>
        </div>
      </section>

      <section class="wrap guide" aria-labelledby="guide-title">
        <div class="section-copy">
          <h2 id="guide-title">建立自己的阅读档案</h2>
          <p>部署一个属于你的阅纹实例，连接微信读书，就能生成并带走自己的报告。</p>
        </div>
        <ul class="guide-links">
          {guides.map((item) => (
            <li>
              <a href={item.href}>
                <span>
                  <span class="guide-title">{item.title}</span>
                  <span class="guide-desc">{item.desc}</span>
                </span>
                <svg class="guide-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <footer class="wrap footer">
      <a class="brand" href="/">
        <img class="logo-light" src="/favicon.svg" alt="" width="24" height="24" />
        <img class="logo-dark" src="/favicon-dark.svg" alt="" width="24" height="24" />
        阅纹
      </a>
      <span class="footer-motto">每一页，都留下你的纹理。</span>
      <a href="/docs/">使用文档</a>
      <a href="https://github.com/sunpm/yuewen">GitHub</a>
    </footer>

    <script is:inline>
      ;(function () {
        var inputs = document.querySelectorAll('input[name="site-theme"]')
        var media = typeof matchMedia === 'function' ? matchMedia('(prefers-color-scheme: dark)') : null
        function readPref() {
          try {
            var v = localStorage.getItem('yuewen-theme')
            if (v === 'light' || v === 'dark') return v
          } catch (e) {}
          return 'auto'
        }
        function apply(pref) {
          var dark = pref === 'dark' || (pref === 'auto' && media && media.matches)
          document.documentElement.classList.toggle('dark', dark)
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light'
          var meta = document.querySelector('meta[name="theme-color"]')
          if (meta) meta.setAttribute('content', dark ? '#141a17' : '#f8f9f6')
          inputs.forEach(function (el) {
            el.checked = el.value === pref
          })
        }
        var current = readPref()
        apply(current)
        inputs.forEach(function (el) {
          el.addEventListener('change', function () {
            current = el.value
            try {
              localStorage.setItem('yuewen-theme', current)
              localStorage.setItem('starlight-theme', current === 'auto' ? '' : current)
            } catch (e) {}
            apply(current)
          })
        })
        if (media && media.addEventListener) {
          media.addEventListener('change', function () {
            apply(readPref())
          })
        }
        var desk = document.querySelector('.still-life')
        var reduce = typeof matchMedia === 'function' && matchMedia('(prefers-reduced-motion: reduce)').matches
        if (desk && !reduce) {
          desk.addEventListener('pointermove', function (e) {
            if (e.pointerType !== 'mouse') return
            var r = desk.getBoundingClientRect()
            var dx = (e.clientX - r.left) / r.width - 0.5
            var dy = (e.clientY - r.top) / r.height - 0.5
            desk.style.setProperty('--tilt-x', (-dy * 4).toFixed(2) + 'deg')
            desk.style.setProperty('--tilt-y', (dx * 5).toFixed(2) + 'deg')
          })
          desk.addEventListener('pointerleave', function () {
            desk.style.setProperty('--tilt-x', '0deg')
            desk.style.setProperty('--tilt-y', '0deg')
          })
        }
      })()
    </script>
  </body>
</html>
