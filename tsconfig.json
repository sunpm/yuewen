{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ES2022.Intl"],
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["web/src/*"],
      "@shared/*": ["shared/*"],
      "@client/*": ["client/*"]
    }
  },
  "include": [
    "shared/**/*.ts",
    "server/**/*.ts",
    "scripts/**/*.ts",
    "netlify/**/*.ts",
    "tests/**/*.ts",
    "*.ts",
    "client/**/*.ts",
    "client/**/*.vue",
    "web-mobile/**/*.ts",
    "web-mobile/**/*.vue",
    "web/src/components/ui/input/Input.vue"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "console",
    "vite.console.config.ts",
    "web/src/**/*.tsx",
    "vite.config.ts"
  ]
}
